// Quiet Premium: shared, native-only styling values.
// Visual treatment belongs to the application shell, never to upstream media.
export global QuietPremium {
    in-out property <length> card-radius: 15px;
    in-out property <length> control-radius: 10px;
    in-out property <length> media-radius: 10px;
    in-out property <duration> hover-motion: 160ms;
    in-out property <duration> tab-motion: 180ms;
    in-out property <color> light-hover: #f5faf5;
    in-out property <color> dark-hover: #2b3b30;
    in-out property <color> light-pressed: #edf5ec;
    in-out property <color> dark-pressed: #354b39;
    in-out property <color> light-outline: #9dc1a4;
    in-out property <color> dark-outline: #7caa85;
    in-out property <color> light-shadow: #23452b25;
    in-out property <color> dark-shadow: #00000048;
}
