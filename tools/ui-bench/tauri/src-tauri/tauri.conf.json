{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Challenger UI Bench — Tauri",
  "version": "0.1.0",
  "identifier": "io.velvetos.challenger.tauribench",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Challenger · Tauri WebView vs Rust",
        "width": 1190,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
