{
  "schema": "challenger-adapters.v1",
  "reviewedAt": "2026-10-09",
  "policy": "Only exact allowlisted GitHub Release assets with a GitHub-published SHA-256 digest; no arbitrary executable setup scripts. Platform adapter can still reject unsupported/malformed/unsigned content. Every install requires confirmation.",
